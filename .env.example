# Copy this file to .env.local and fill in the values.

# Upstash Redis (https://console.upstash.com, or Vercel → Storage → Upstash Redis).
# On Vercel the integration may set KV_REST_API_URL / KV_REST_API_TOKEN instead; both work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Your login password.
APP_PASSWORD=

# Random string, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
